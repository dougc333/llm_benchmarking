# Runpod SSH connection used by the macOS deployment and tunnel scripts.
RUNPOD_HOST=YOUR_RUNPOD_HOST
RUNPOD_PORT=YOUR_RUNPOD_SSH_PORT
RUNPOD_USER=root
RUNPOD_SSH_KEY="${HOME}/.ssh/id_ed25519"

# The API is private on Runpod and forwarded to this macOS port.
LOCAL_API_PORT=8787
REMOTE_API_HOST=127.0.0.1
REMOTE_API_PORT=8787

# Runpod paths and executables.
REMOTE_WORKSPACE=/workspace
REMOTE_APP_DIR=/workspace/benchmark-dashboard
REMOTE_SWEEP_SCRIPT=/workspace/concurrency_sweep.py
REMOTE_PYTHON=/opt/vllm-venv/bin/python
REMOTE_VLLM_BIN=/opt/vllm-venv/bin/vllm
REMOTE_PYTHON_VERSION=3.11
VLLM_VERSION=0.10.2
REMOTE_HF_HOME=/workspace/huggingface
REMOTE_RUN_ROOT=/workspace/past_runs
REMOTE_OUTPUT=/workspace/output.txt

# Full-sweep defaults. The smoke-test button overrides concurrency and prompts.
BENCHMARK_MODEL=Qwen/Qwen2.5-7B-Instruct
BENCHMARK_CONCURRENCY="1 8 16 32 64 128 256 512"
BENCHMARK_MAX_NUM_SEQS=256
BENCHMARK_MAX_NUM_BATCHED_TOKENS=8192
BENCHMARK_MAX_MODEL_LEN=32768
BENCHMARK_GPU_MEMORY_UTILIZATION=0.9
BENCHMARK_INPUT_TOKENS=1024
BENCHMARK_OUTPUT_TOKENS=256
