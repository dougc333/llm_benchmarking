# Copy to .env. Never commit .env; the repository ignores it recursively.
HF_TOKEN=

# GPU providers
VAST_API_KEY=
DIGITALOCEAN_TOKEN=
HYPERBOLIC_API_KEY=

# Optional provider defaults
DIGITALOCEAN_SSH_KEY_ID=
ENGINEBENCH_SSH_PRIVATE_KEY=~/.ssh/id_ed25519

# Image pins. Prefer immutable digests for published results.
VLLM_IMAGE=vllm/vllm-openai:latest
SGLANG_IMAGE=lmsysorg/sglang:latest
TRTLLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:latest
